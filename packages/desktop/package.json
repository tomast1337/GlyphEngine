{
    "name": "@glyph-engine/desktop",
    "version": "0.1.0",
    "description": "GlyphEngine in a native window: run() draws through SDL3 (OpenGL, Vulkan, SDL GPU or software) via bun:ffi. Linux for now; needs SDL3 and SDL3_ttf.",
    "keywords": [
        "ascii",
        "ascii-art",
        "sdl3",
        "vulkan",
        "opengl",
        "bun",
        "ffi"
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/tomast1337/GlyphEngine#readme",
    "bugs": "https://github.com/tomast1337/GlyphEngine/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tomast1337/GlyphEngine.git",
        "directory": "packages/desktop"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "bun": ">=1.4.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rm -rf dist && bun build src/index.ts --target bun --outdir dist --external @glyph-engine/core && tsc -p tsconfig.build.json",
        "prepublishOnly": "bun run build",
        "prepack": "cp ../../LICENSE ."
    },
    "dependencies": {
        "@glyph-engine/core": "workspace:*"
    }
}
