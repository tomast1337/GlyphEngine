{
    "name": "glyph-engine",
    "version": "1.0.0",
    "description": "Core files, example and demos of the live-code ASCII playground:   [play.ertdfgcvb.xyz](https://play.ertdfgcvb.xyz)",
    "main": "index.js",
    "type": "module",
    "directories": {
        "test": "tests"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "test": "bun test",
        "bench": "bun run script/bench.ts",
        "build": "bun run clean && bun build src/index.ts --target browser --outdir dist && bun run build:types",
        "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
        "prepublishOnly": "bun run build",
        "clean": "rm -rf dist",
        "build:examples": "bun run script/build-examples.ts",
        "dev": "bun run build:examples -- --watch"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@webgpu/types": "^0.1.74",
        "playwright": "^1.65.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
