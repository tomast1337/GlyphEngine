{
    "compilerOptions": {
        // Environment setup & latest features
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "target": "ESNext",
        "module": "Preserve",
        "moduleDetection": "force",
        "jsx": "react-jsx",
        "allowJs": true,
        // Bundler mode
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        // Best practices
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        // Some stricter flags (disabled by default)
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false,
        // Workspace packages resolve to their sources: no build needed to run or test
        "paths": {
            "@glyph-engine/core": ["./packages/core/src/index.ts"],
            "@glyph-engine/web": ["./packages/web/src/index.ts"],
            "@glyph-engine/tui": ["./packages/tui/src/index.ts"],
            "@glyph-engine/desktop": ["./packages/desktop/src/index.ts"]
        }
    },
    "include": ["packages/*/src", "programs", "script", "tests", "examples"],
    "exclude": ["**/dist"]
}
