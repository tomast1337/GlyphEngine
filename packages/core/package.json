{
    "name": "@glyph-engine/core",
    "version": "0.2.0",
    "description": "Platform-free core of GlyphEngine: frames, the out slot, computeFrame() and the modules programs use.",
    "keywords": [
        "ascii",
        "ascii-art",
        "text-mode",
        "generative",
        "creative-coding"
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/tomast1337/GlyphEngine#readme",
    "bugs": "https://github.com/tomast1337/GlyphEngine/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tomast1337/GlyphEngine.git",
        "directory": "packages/core"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "bun ../../script/build-package.ts --target=browser",
        "prepublishOnly": "bun run build"
    }
}
